#!/usr/bin/env bash
set -euo pipefail

SERVER_ROOT="${CODEX_SERVER_ROOT:-${HOME}/.codex/servers}"
ROOT="${CODEX_IMAGE_GEN_HOME:-${SERVER_ROOT}/image-gen}"
COMFY="${COMFYUI_HOME:-${ROOT}/ComfyUI}"
PY="${COMFYUI_PYTHON:-${ROOT}/.venv/bin/python}"
HOST="${CODEX_IMAGE_GEN_HOST:-127.0.0.1}"
PORT="${CODEX_IMAGE_GEN_PORT:-8188}"
SCREEN_NAME="codex-image-gen"
LOG_DIR="${ROOT}/logs"
LOG_FILE="${LOG_DIR}/comfyui.log"

if [[ ! -d "$COMFY" ]]; then
  echo "ComfyUI is missing: $COMFY" >&2
  exit 1
fi
if [[ ! -x "$PY" ]]; then
  echo "Python environment is missing: $PY" >&2
  echo "Run bin/codex-image-gen-install first." >&2
  exit 1
fi
if screen -ls | grep -Fq "$SCREEN_NAME"; then
  echo "Codex image generation already running in screen session: $SCREEN_NAME"
  exit 0
fi
if lsof -tiTCP:"$PORT" -sTCP:LISTEN >/dev/null 2>&1; then
  echo "Port ${PORT} is already in use." >&2
  exit 1
fi

mkdir -p "$LOG_DIR" "${ROOT}/outputs"
: > "$LOG_FILE"

screen -dmS "$SCREEN_NAME" /bin/bash -lc 'cd "$1" && exec "$2" main.py --listen "$3" --port "$4" --output-directory "$5" >>"$6" 2>&1' _ "$COMFY" "$PY" "$HOST" "$PORT" "${ROOT}/outputs" "$LOG_FILE"
echo "ComfyUI started in screen session: $SCREEN_NAME"
echo "URL: http://${HOST}:${PORT}"
echo "Logs: ${LOG_FILE}"
